# Ethos-Deployment des TechStack Analyzers (für das CX Coworker Gateway).
# Kopiere nach .env.ethos und passe die Werte an (.env.ethos wird nie committet).
# Verwendung: make ethos-image | ethos-secrets | ethos-deploy | ethos-migrate-db | ethos-status
# Runbook: docs/ethos-deployment.md

# kubectl-Kontext (Cluster aus dem DevHome-Catalog, z. B. ethos105-stage-or2) und Namespace
ETHOS_CONTEXT=<cluster-context>
ETHOS_NAMESPACE=ns-team-techstack-analyzer

# Hostname des Contour-HTTPProxy auf einem INT-Cluster (nicht corp/ats!), Muster wie statusmcp:
# techstack-mcp.int.<cluster>.ethos.adobe.net
ETHOS_HOST=techstack-mcp.int.<cluster>.ethos.adobe.net

# Container-Registry (GitHub Packages); Token NICHT hier, sondern beim Aufruf:
#   GHCR_TOKEN=$(pbpaste) make ethos-secrets
GHCR_USER=<github-user>
GHCR_IMAGE=ghcr.io/<github-user>/techstack-analyzer

# Optional: MariaDB-Image (falls Docker Hub im Cluster gesperrt ist → Artifactory-Mirror)
# MARIADB_IMAGE=docker-hub-remote.dr-uw2.adobeitc.com/library/mariadb:11

# Optional: App-Secrets aus einer lokalen Datei statt von der Corp-VM ($REMOTE_DIR/.env via SSH)
# ETHOS_ENV_FILE=project/.env
