# Deploy-Konfiguration für TechStackCrawler
# Kopiere nach .env.deploy und passe die Werte an (.env.deploy wird nie committet).
# Verwendung: make deploy (liest diese Datei automatisch)
#
# Port-Matrix auf dem Server: siehe docs/deployment.md
# Bereits belegt: 8513 (RFP Tool), 8519 (BattleMind), 8510/80/443 (Hub)

# SSH-Verbindung
SSH_HOST=user@<server-host>
# Optional: Pfad zum SSH-Key relativ zum Repo-Root (Key-Dateien sind per .gitignore ausgeschlossen)
# SSH_KEY=<your-key-file>

# Zielverzeichnis auf dem Server (eindeutig pro Projekt!)
REMOTE_DIR=/opt/techstack-crawler

# Host-Port der App (Hub-Caddy proxied techstack.corp.adobe.com → 172.17.0.1:8516)
HOST_PORT=8516

# Container-Präfix (vermeidet Namenskonflikte mit RFP Tool etc.)
CONTAINER_PREFIX=techstack-

# DB-Passwörter gehören NICHT hierher, sondern in die .env auf dem Server
# (das Backup-Script liest DB_ROOT_PASSWORD dort).
