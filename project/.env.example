# Bedrock: API-Key aus .env ODER aus AWS Secrets Manager
# Option A: Direkt in .env
# BEDROCK_API_KEY=ABSK...

# Option B: Aus Secrets Manager (erfordert AWS-Credentials: aws configure)
BEDROCK_SECRET_NAME=bedrock/AWS4457/DEV/api-key
# Für Key-Rotation: npm run rotate-bedrock-key (IAM-User, optional)
# BEDROCK_IAM_USER=bedrock-api-user-AWS4457-DEV
BEDROCK_ENDPOINT=https://bedrock-runtime.us-west-2.amazonaws.com
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
BEDROCK_REGION=us-west-2
PORT=3001
NODE_ENV=development

# ElevenLabs (für Javlyn Voice-Assistent, Eleven v3 mit Audio Tags)
# TTS wird 1x pro Text generiert und gecacht (DB + In-Memory) – spart API-Kosten
ELEVENLABS_API_KEY=sk_...
ELEVENLABS_VOICE_ID=your_voice_id
# Optional: eleven_v3 (Standard), eleven_multilingual_v2 (Fallback)
# ELEVENLABS_MODEL=eleven_v3

# Optional: Mock-AI für Tests ohne gültigen Bedrock-Key (403/expired)
# USE_MOCK_AI=1

# Okta SSO (Admin-/Dashboard-Login, OIDC Authorization Code Flow)
# Werte aus der OSS-App (oss.corp.adobe.com). Secret NUR in .env, niemals committen.
OKTA_CLIENT_ID=0oaXXXXXXXXXXXXXXXXX
OKTA_CLIENT_SECRET=__from_OSS_shown_once__
OKTA_REDIRECT_URI=https://techstack.corp.adobe.com/auth/callback
# Wer Admin-/Dashboard-Zugriff bekommt (komma-getrennt, case-insensitive)
ADMIN_EMAILS=admin1@adobe.com,admin2@adobe.com
# Optional (Defaults sind für Adobe Prod korrekt):
# OKTA_ISSUER=https://adobe.okta.com          # Token `iss` — OHNE /oauth2
# OKTA_SCOPES=openid profile email

# Break-Glass-Login (Notfallzugang, falls Okta nicht verfügbar ist).
# Nur aktiv, wenn BEIDE Werte gesetzt sind — sonst antwortet /api/dashboard/login mit 503.
# Es gibt bewusst keinen Default, damit kein Passwort im Quellcode steht.
# Hash erzeugen (scrypt, gesalzen; Legacy-SHA-256 wird noch akzeptiert, aber gewarnt):
#   npm run hash-dashboard-password -- 'DEIN_PASSWORT'
# DASHBOARD_EMAIL=you@adobe.com
# DASHBOARD_PASSWORD_HASH=

# CORS (Production): komma-getrennte Liste erlaubter Origins. Ohne Wert sind nur
# Same-Origin-Aufrufe erlaubt (Frontend und API laufen auf derselben Domain).
# CORS_ORIGIN=https://techstack.corp.adobe.com

# Datenbank – lokal SQLite (Default), Production MariaDB
# Option A: SQLite (lokal, kein Docker nötig)
DB_TYPE=sqlite
# DB_PATH=./data/techstack.db

# Option B: MariaDB (Docker / Production)
# ACHTUNG: docker-compose.yml erzwingt DB_PASSWORD und DB_ROOT_PASSWORD (kein Default mehr).
# Ohne diese Werte bricht `docker compose up` bewusst ab, damit nie ein bekanntes
# Standardpasswort in Betrieb geht. Beide Werte selbst vergeben, z.B. mit:
#   openssl rand -base64 24
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=techstack
# DB_PASSWORD=
# DB_NAME=techstack_crawler
# DB_ROOT_PASSWORD=
